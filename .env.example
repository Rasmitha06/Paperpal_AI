# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# Never commit .env to GitHub (it contains secrets).

# --- Auth ---
JWT_SECRET=your-long-random-secret-string
JWT_EXPIRE_DAYS=7
GUEST_DAILY_LIMIT=2

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
EMBEDDING_MODEL=text-embedding-ada-002
CHAT_MODEL=gpt-4o-mini

# --- Pinecone ---
# Create an index at https://app.pinecone.io (cosine, 1536 dimensions for ada-002)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=paperpal
PINECONE_ENVIRONMENT=
# Set true if the index already exists (skips list/create on each upload)
PINECONE_SKIP_INDEX_BOOTSTRAP=true

# --- Chunking & retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.72

# --- OCR (scanned PDFs) — optional: brew install tesseract ---
OCR_ENABLED=true
OCR_MIN_TEXT_CHARS=80
OCR_LANG=eng

# --- Vision (charts / figures on upload) ---
VISION_ENABLED=true
VISION_MODEL=gpt-4o-mini

# --- Full-document summary (speed) ---
SUMMARY_MODEL=gpt-4o-mini
SUMMARY_MERGE_MODEL=
SUMMARY_ONE_SHOT_MAX_PAGES=28
SUMMARY_ONE_SHOT_MAX_CHARS=96000
SUMMARY_PAGES_PER_BATCH=10
SUMMARY_MAX_BATCH_CHARS=32000
SUMMARY_MAX_PAGE_CHARS=5000
SUMMARY_MAX_WORKERS=4

# --- CORS (frontend dev server) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
